open "geometry.cub5"

# Cut geometry in half

webcut volume 1 2 with plane xplane
imprint volume all 
merge volume all 
compress

# create surface groups for fluid volume (volume 2)

create group "rounded_edge_surfaces"
rounded_edge_surfaces add surface 14 15 16 17 18 19 23 37 39 

create group "rounded_cavity_surfaces"
rounded_cavity_surfaces add surface 31 32 33 

create group "flat_cavity_surfaces"
flat_cavity_surfaces add surface 2 3 5 9 

create group "flat_side_surfaces"
flat_side_surfaces add surface 34 38 40

create group "flat_streamwise_surfaces"
flat_streamwise_surfaces add surface 10 

create group "flat_tangential_surfaces"
flat_tangential_surfaces add surface 58

create group "base_boundary_surfaces"
base_boundary_surfaces add surface in rounded_edge_surfaces
base_boundary_surfaces add surface in rounded_cavity_surfaces
base_boundary_surfaces add surface in flat_cavity_surfaces
base_boundary_surfaces add surface in flat_side_surfaces

# add boundary layers

create boundary_layer 1
modify boundary_layer 1 uniform height {1.0e-02} growth 1.15 layers 10
modify boundary_layer 1 add surface in base_boundary_surfaces volume 2
modify boundary_layer 1 continuity on

create boundary_layer 2
modify boundary_layer 2 uniform height {7.5e-02} growth 1.25 layers 1
modify boundary_layer 2 add surface in base_boundary_surfaces volume 1
modify boundary_layer 2 continuity on

# mesh size

volume 1 size 1.0
volume 1 Tetmesh growth_factor 1.1

volume 2 size 1.0
volume 2 Tetmesh growth_factor 1.5

surface in rounded_cavity_surfaces  sizing function skeleton min_size 0.25 max_size 0.25 max_span_ang_surf 25.0 max_span_ang_curve 25.0 max_gradient 1.0
surface in rounded_edge_surfaces    sizing function skeleton min_size 0.15 max_size 0.15 max_span_ang_surf 1.0  max_span_ang_curve  1.0 max_gradient 1.5
surface in flat_cavity_surfaces     sizing function skeleton min_size 0.25 max_size 0.25 max_span_ang_surf 25.0 max_span_ang_curve 25.0 max_gradient 1.0
surface in flat_side_surfaces       sizing function skeleton min_size auto max_size 0.5  max_gradient 1.0
surface in flat_tangential_surfaces sizing function skeleton min_size 0.25  max_size 0.25  max_gradient 1.0
surface in flat_streamwise_surfaces sizing function skeleton min_size auto max_size 2.0  max_gradient 1.075

# generate fluid mesh

volume 1 2 scheme tetmesh
mesh volume 1 2

# copy fluid mesh to the other half

volume 1 copy reflect x
merge volume 1 5
delete volume 3

volume 2 copy reflect x
merge volume 2 6
delete volume 4

# Set 2nd order elements

block 1 add volume 1 5
block 1 element type TETRA10
block 1 element type WEDGE15

block 2 add volume 2 6
block 2 element type TETRA10
block 2 element type WEDGE15

# list model details

List Model

# Create sidesets for fluid BCs and export mesh

# {Lref=0.006}
# {mm2m=0.001}
transform mesh output scale {mm2m/Lref}
set exodus netcdf4 off
set large exodus file on

sideset 1 add surface 106 wrt volume 6
sideset 1 name "inlet"
sideset 2 add surface 10 wrt volume 2
sideset 2 name "outlet"
sideset 3 add surface in base_boundary_surfaces wrt volume 2
sideset 3 add surface 88 89 90 91 92 93 94 95 96 97 98 99 100 101 102 103 104 105 107 wrt volume 6
sideset 3 name "fluid_solid_interface"

export mesh "fluid_mesh.exo" block 2 overwrite

# generate solid mesh

delete sideset 1 to 3
sideset 1 add surface 36 41 wrt volume 1
sideset 1 add surface 69 85 wrt volume 5
sideset 1 name "flux"
sideset 2 add surface 25 28 29 30 35 42 wrt volume 1
sideset 2 add surface 60 61 62 67 68 86 wrt volume 5
sideset 2 name "adiabatic"
sideset 3 add surface in base_boundary_surfaces wrt volume 1
sideset 3 add surface 63 64 65 66 70 71 72 73 74 75 76 77 78 79 80 81 82 83 84 wrt volume 5
sideset 3 name "fluid_solid_interface"

export mesh "solid_mesh.exo" block 1 overwrite

save cub5 "mesh.cub5" overwrite journal